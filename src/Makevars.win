# rjags supplies the flags for the JAGS library loaded by this R installation.
JAGS_RSCRIPT := "$(R_HOME)/bin$(R_ARCH_BIN)/Rscript" --vanilla
PKG_CPPFLAGS := $(shell $(JAGS_RSCRIPT) -e "rjags::pkg.compile.flags('CPPFLAGS')") -I../inst/include -DR_NO_REMAP
PKG_CXXFLAGS := $(shell $(JAGS_RSCRIPT) -e "rjags::pkg.compile.flags('CXXFLAGS')")
PKG_LIBS := $(shell $(JAGS_RSCRIPT) -e "rjags::pkg.compile.flags('LIBS')") -ljrmath-0

include Makevars.common
