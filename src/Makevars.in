	gamma/BTGammaCore.cc gamma/BTGammaCore.h \
	invgamma/BTInvGammaCore.cc invgamma/BTInvGammaCore.h \
	lkj/BTLKJCore.cc \
	nonlocal/BTNonlocalCore.cc nonlocal/BTNonlocalCore.h
