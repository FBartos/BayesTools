intercept <- rnorm(500)
slope     <- rnorm(500, sd = .5)
x_grid    <- seq(-1, 1, length.out = 5)
line      <- outer(intercept, rep(1, 5)) + outer(slope, x_grid)
harrell_davis_quantile(line, c(.025, .5, .975), names = TRUE)

